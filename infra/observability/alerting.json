          "uid": "waba-telemetry-unavailable",
          "title": "Collecteur attendu indisponible",
          "condition": "B",
          "for": "1m",
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "Une source attendue ne produit plus de mesures. Les pauses volontaires ne d\u00e9clenchent pas cette r\u00e8gle."
          },
          "labels": {
            "team": "waba",
            "severity": "warning",
            "scenario": "live"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "waba-prometheus",
              "model": {
                "refId": "A",
                "expr": "((waba_telemetry_expected == 1) unless on(source) (waba_telemetry_available == 1)) or (1 - waba_telemetry_available{source=~\"spark|kubernetes\"})",
                "instant": true,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
