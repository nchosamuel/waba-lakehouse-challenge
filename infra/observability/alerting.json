  "contactPoints": [
    {
      "orgId": 1,
      "name": "waba-local",
      "receivers": [
        {
          "uid": "waba-local-webhook",
          "type": "webhook",
          "settings": {
            "url": "http://observability-exporter.processing:9108/alerts",
            "httpMethod": "POST"
          },
          "disableResolveMessage": false
        }
      ]
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "waba-local",
      "group_by": [
        "alertname",
        "scenario"
      ],
      "group_wait": "5s",
      "group_interval": "10s",
      "repeat_interval": "1h"
