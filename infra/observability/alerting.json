        {
          "uid": "waba-spark-fraud",
          "title": "Fraude Spark en erreur > 5 minutes",
          "condition": "B",
          "for": "5m",
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "\u00c9chec du job streaming de fraude pendant cinq minutes."
          },
          "labels": {
            "team": "waba",
            "severity": "warning",
            "scenario": "live"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "waba-prometheus",
              "model": {
                "refId": "A",
                "expr": "waba_spark_fraud_failed",
                "instant": true,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        },
