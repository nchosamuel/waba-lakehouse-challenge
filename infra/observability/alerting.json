{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "WABA operational",
      "folder": "WABA",
      "interval": "30s",
      "rules": [
        {
          "uid": "waba-spark-fraud",
          "title": "Fraude Spark en erreur > 5 minutes",
          "condition": "B",
          "for": "5m",
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "\u00c9chec continu du job streaming de fraude pendant cinq minutes. scenario=demo identifie les tests."
          },
          "labels": {
            "team": "waba",
            "severity": "warning"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "waba-prometheus",
              "model": {
                "refId": "A",
                "expr": "waba_spark_fraud_failed or waba_demo_spark_fraud_failed",
                "instant": true,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "waba-kafka-aml",
          "title": "Retard Kafka AML > 5 000 messages",
          "condition": "B",
          "for": "0s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "Retard r\u00e9el du checkpoint partag\u00e9 fraude/AML ; pas de groupe AML s\u00e9par\u00e9. scenario=demo identifie les tests."
          },
          "labels": {
            "team": "waba",
            "severity": "warning"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "waba-prometheus",
              "model": {
                "refId": "A",
                "expr": "waba_kafka_query_lag_messages{query=\"silver_to_gold\"} or waba_demo_kafka_aml_lag_messages",
                "instant": true,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        5000
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "waba-regulatory",
          "title": "Rapport r\u00e9glementaire manquant \u00e0 06 h UTC",
          "condition": "B",
          "for": "0s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "Run planifi\u00e9 J+1 non r\u00e9ussi \u00e0 l\u2019\u00e9ch\u00e9ance UTC. scenario=demo identifie les tests."
          },
          "labels": {
            "team": "waba",
            "severity": "warning"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "waba-prometheus",
              "model": {
                "refId": "A",
                "expr": "waba_regulatory_deadline_missed or waba_demo_regulatory_deadline_missed",
                "instant": true,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "contactPoints": [
    {
      "orgId": 1,
      "name": "waba-local",
      "receivers": [
        {
          "uid": "waba-local-webhook",
          "type": "webhook",
          "settings": {
            "url": "http://observability-exporter.processing:9108/alerts",
            "httpMethod": "POST"
          },
          "disableResolveMessage": false
        }
      ]
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "waba-local",
      "group_by": [
        "alertname",
        "scenario"
      ],
      "group_wait": "5s",
      "group_interval": "10s",
      "repeat_interval": "1h"
    }
  ]
}
