    },
    {
      "id": 3,
      "title": "Disponibilit\u00e9 des collecteurs",
      "description": "0 signifie mesure indisponible ; aucune valeur r\u00e9elle remplac\u00e9e par z\u00e9ro.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "waba-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "waba_telemetry_available",
          "legendFormat": "{{component}}{{source}}{{exported_job}} {{country_scope}}{{query}}{{dag}}{{scenario}}",
          "instant": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Dur\u00e9e des jobs Spark par p\u00e9rim\u00e8tre pays",
      "description": "Dur\u00e9e du job entier. CI indique un traitement CI ; ALL indique un traitement partag\u00e9, pas une mesure ind\u00e9pendante par pays.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "waba-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pays / p\u00e9rim\u00e8tre"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Traitement"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "\u00c9tat"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dur\u00e9e"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Application"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "waba_spark_job_duration_seconds",
          "legendFormat": "{{component}}{{source}}{{exported_job}} {{country_scope}}{{query}}{{dag}}{{scenario}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "country_scope": 0,
              "exported_job": 1,
              "state": 2,
              "Value": 3,
              "application": 4
            },
            "renameByName": {
              "country_scope": "Pays / p\u00e9rim\u00e8tre",
              "exported_job": "Traitement",
              "state": "\u00c9tat",
              "Value": "Dur\u00e9e",
              "application": "Application"
            }
          }
        }
      ]
    },
