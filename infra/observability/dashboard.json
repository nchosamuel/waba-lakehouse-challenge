{
  "uid": "waba-health",
  "title": "WABA \u2014 Sant\u00e9 des pipelines",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "WABA",
    "local",
    "observability"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Services actifs \u2014 r\u00e9plicas pr\u00eats",
      "description": "Comparer avec les r\u00e9plicas demand\u00e9s : 0 demand\u00e9 signifie un arr\u00eat volontaire.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "waba-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "waba_component_ready_replicas",
          "legendFormat": "{{component}}{{source}}{{exported_job}} {{country_scope}}{{query}}{{dag}}{{scenario}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
